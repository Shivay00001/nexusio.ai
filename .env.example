# ╔══════════════════════════════════════════════════════════════╗
# ║              NexusAI — Environment Configuration            ║
# ╚══════════════════════════════════════════════════════════════╝
# Copy this file to .env and fill in the values you want.
# All providers with no API key work out of the box.
# API keys are optional — the system works without them using
# Ollama, g4f, and Pollinations as free/no-key providers.

# ── Server ──────────────────────────────────────────────────
NEXUS_HOST=127.0.0.1
NEXUS_PORT=8000
NEXUS_DEBUG=true

# ── Ollama (Local — no key needed) ──────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2

# ── g4f / GPT4Free (no key needed) ─────────────────────────
G4F_DEFAULT_MODEL=gpt-4o-mini

# ── Pollinations (no key needed for free tier) ──────────────
POLLINATIONS_DEFAULT_MODEL=openai

# ── OpenRouter (free key from https://openrouter.ai) ────────
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=google/gemma-3-27b-it:free

# ── Groq (free key from https://console.groq.com) ──────────
GROQ_API_KEY=
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile

# ── HuggingFace (free key from https://huggingface.co) ──────
HF_API_KEY=
HF_DEFAULT_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# ── Agent Settings ──────────────────────────────────────────
AGENT_MAX_ITERATIONS=10
AGENT_DEFAULT_PROVIDER=ollama

# ── Provider Priority (comma separated, first = highest) ────
PROVIDER_PRIORITY=ollama,groq,g4f,pollinations,openrouter,huggingface
